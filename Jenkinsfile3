pipeline {
    agent any

    environment {
        // Docker Hub వివరాలు (మీ పాత ఫైల్ ప్రకారం)
        DOCKER_CREDS_ID = 'docker' // జెంకిన్స్‌లో మీరు డాకర్ హబ్ కి ఇచ్చిన క్రెడెన్షియల్ ID
        DOCKER_IMAGE    = 'kastrov/bms' 
        IMAGE_TAG       = 'latest'

        // AWS ECR & EKS వివరాలు
        AWS_REGION      = 'ap-south-1'
        // కింద మీ ECR రిపోజిటరీ URL ఇవ్వండి (లాస్ట్‌లో /repo-name లేకుండా)
        ECR_REGISTRY    = '123456789012.dkr.ecr.ap-south-1.amazonaws.com'
        // కింద మీ ECR రిపోజిటరీ పేరు ఇవ్వండి
        ECR_REPO_NAME   = 'bookmyshow-repo'
    }

    stages {
        stage('Checkout Code') {
            steps {
                echo "Fetching code from GitHub..."
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo "Building Docker Image..."
                    // బేసిక్ ఇమేజ్ బిల్డ్
                    sh "docker build -t ${DOCKER_IMAGE}:${IMAGE_TAG} ."
                    
                    // ECR కోసం అదే ఇమేజ్‌కి ఇంకో పేరు (Tag) ఇస్తున్నాం
                    sh "docker tag ${DOCKER_IMAGE}:${IMAGE_TAG} ${ECR_REGISTRY}/${ECR_REPO_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('Push to Docker Hub') {
            steps {
                script {
                    echo "Pushing image to Docker Hub..."
                    withDockerRegistry(credentialsId: "${DOCKER_CREDS_ID}", toolName: 'docker') {
                        sh "docker push ${DOCKER_IMAGE}:${IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Push to AWS ECR') {
            steps {
                script {
                    echo "Logging into AWS ECR..."
                    // IAM రోల్ ఉంది కాబట్టి ఆటోమేటిక్ గా లాగిన్ అవుతుంది
                    sh "aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}"
                    
                    echo "Pushing Image to AWS ECR..."
                    sh "docker push ${ECR_REGISTRY}/${ECR_REPO_NAME}:${IMAGE_TAG}"
                }
            }
        }

        stage('Deploy to AWS EKS') {
            steps {
                script {
                    echo "Deploying Application to Kubernetes Cluster..."
                    // వర్కర్ నోడ్‌లో kubeconfig ఉంది కాబట్టి నేరుగా రన్ అవుతాయి
                    sh "kubectl apply -f deployment.yaml"
                    sh "kubectl apply -f service.yaml"
                }
            }
        }
    }
}
